### ============================================================
### 5. VOLTRAS - BOOK FLIGHT
### ============================================================
### Format tanggal: YYYY-MM-DD
### throughfare: false = sumlocal (classcode di tiap segment)
###              true  = throughfare (classcode di level trip)

### Book OW - 1 Adult, Direct, Sumlocal
POST {{baseUrl}}/api/v1/voltras/flight/book
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "adult_count": 1,
  "child_count": 0,
  "infant_count": 0,
  "with_insurance": false,
  "service_fee": 0,
  "trips": [
    {
      "trip_type": "departure",
      "airline_code": "GA",
      "trip_date": "2025-08-01",
      "throughfare": false,
      "segments": [
        {
          "flight_no": "GA400",
          "class_code": "Y",
          "from_city": "CGK",
          "to_city": "DPS",
          "depart_date": "2025-08-01",
          "depart_time": "05:35",
          "arrive_time": "08:40"
        }
      ]
    }
  ],
  "listpax": [
    {
      "title": "MS",
      "first_name": "Khatarina",
      "last_name": "Alexandria",
      "type": "ADULT",
      "passport": {
        "no": "",
        "nationality": "",
        "issuing_country": "ID",
        "expiry": ""
      }
    }
  ],
  "paxcontact": {
    "first_name": "Khatarina",
    "last_name": "Alexandria",
    "phone1": "089922228888"
  },
  "agentcontact": {
