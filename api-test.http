### ============================================================
### API TEST - MOBILE API (Voltras Flight Integration)
### Compatible: VS Code REST Client / JetBrains HTTP Client
### ============================================================

@baseUrl = http://localhost:8080
@token = your_jwt_token_here
@adminToken = your_admin_jwt_token_here
@contentType = application/json


### ============================================================
### 1. AUTH
### ============================================================

### Register
POST {{baseUrl}}/api/v1/auth/register
Content-Type: {{contentType}}

{
  "first_name": "John",
  "last_name": "Doe",
  "phone": "08123456789",
  "email": "john.doe@example.com",
  "password": "password123"
}

###

### Login
# @name login
POST {{baseUrl}}/api/v1/auth/login
Content-Type: {{contentType}}

{
  "phone": "08123456789",
  "password": "password123"
}

###

### Refresh Token
POST {{baseUrl}}/api/v1/auth/refresh
Content-Type: {{contentType}}

{
  "refresh_token": "your_refresh_token_here"
}

###

### Logout
POST {{baseUrl}}/api/v1/auth/logout
Authorization: Bearer {{token}}

###


### ============================================================
### 2. VOLTRAS - OFFICE INFO
### ============================================================

### Get Office Information
GET {{baseUrl}}/api/v1/voltras/office-info
Authorization: Bearer {{token}}

###


### ============================================================
### 3. VOLTRAS - FLIGHT SEARCH
### ============================================================

### Search Flight One Way - CGK ke DPS (Garuda + Lion)
POST {{baseUrl}}/api/v1/voltras/flight/search
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "fromcity": "CGK",
  "tocity": "DPS",
  "departdate": "2025-08-01",
  "adult": "1",
  "child": "0",
  "infant": "0"
}

###

### Search Flight One Way - CGK ke SUB
POST {{baseUrl}}/api/v1/voltras/flight/search
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "fromcity": "CGK",
  "tocity": "SUB",
  "departdate": "2025-08-15",
  "adult": "2",
  "child": "1",
  "infant": "0"
}

###

### Search Flight - Missing Required Field (should return 400)
POST {{baseUrl}}/api/v1/voltras/flight/search
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "fromcity": "CGK",
  "tocity": "DPS"
}

###

### Search Flight - Tanggal Lampau (should return 400)
POST {{baseUrl}}/api/v1/voltras/flight/search
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "fromcity": "CGK",
  "tocity": "DPS",
  "departdate": "2020-01-01",
  "adult": "1"
}

###


### ============================================================
### 4. VOLTRAS - RETRIEVE FARE (AIRFARE)
### ============================================================
### Gunakan data dari hasil search (flight_no, class_code, dll)
### Format: sumlocal = direct/connecting sumlocal, throughfare = connecting throughfare

### Retrieve Fare - OW Direct, Sumlocal (1 segment)
POST {{baseUrl}}/api/v1/voltras/flight/fare/retrieve
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "trips": [
    {
      "trip_type": "departure",
      "airline_code": "GA",
      "trip_date": "2025-08-01",
      "throughfare": false,
      "segments": [
        {
          "flight_no": "GA401",
          "class_code": "Y",
          "from_city": "CGK",
          "to_city": "DPS",
          "depart_date": "2025-08-01",
          "depart_time": "06:00",
          "arrive_time": "09:00"
        }
      ]
    }
  ],
  "adult_count": 1,
  "child_count": 0,
  "infant_count": 0,
  "with_insurance": false
}

###

### Retrieve Fare - RT Sumlocal (departure + return, masing-masing direct)
POST {{baseUrl}}/api/v1/voltras/flight/fare/retrieve
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "trips": [
    {
      "trip_type": "departure",
      "airline_code": "GA",
      "trip_date": "2025-08-01",
      "throughfare": false,
      "segments": [
        {
          "flight_no": "GA401",
          "class_code": "Y",
          "from_city": "CGK",
          "to_city": "DPS",
          "depart_date": "2025-08-01",
          "depart_time": "06:00",
          "arrive_time": "09:00"
        }
      ]
    },
    {
      "trip_type": "return",
      "airline_code": "GA",
      "trip_date": "2025-08-08",
      "throughfare": false,
      "segments": [
        {
          "flight_no": "GA402",
          "class_code": "Y",
          "from_city": "DPS",
          "to_city": "CGK",
          "depart_date": "2025-08-08",
          "depart_time": "10:00",
          "arrive_time": "12:00"
        }
      ]
    }
  ],
  "adult_count": 1,
  "child_count": 0,
  "infant_count": 0,
  "with_insurance": false
}

###

